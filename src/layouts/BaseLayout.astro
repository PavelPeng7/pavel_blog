---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pavel's Blog",
  description = 'Notes on Unity, rendering, tools, and computer graphics by Pavel.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={withBase('/img/PPT_transparent_32x32.png')} />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Space Grotesk + DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="cursor-follower"></div>
    <canvas id="three-canvas"></canvas>
    <div id="page-content">
      <slot />
    </div>

    <style>
      #three-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        pointer-events: none;
      }

      #page-content {
        position: relative;
        z-index: 1;
      }

      /* Custom cursor */
      .cursor-follower {
        width: 8px;
        height: 8px;
        border: 1px solid rgba(241, 245, 249, 0.86);
        border-radius: 50%;
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        background: #f8fafc;
        box-shadow: 0 0 14px rgba(248, 250, 252, 0.45);
        transition:
          border-color 180ms ease,
          background-color 180ms ease,
          box-shadow 180ms ease,
          opacity 160ms ease,
          transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        will-change: left, top, transform;
      }

      .cursor-follower.is-visible {
        opacity: 1;
      }

      .cursor-follower.is-hovering {
        transform: translate(-50%, -50%) scale(2.4);
        background-color: rgba(236, 72, 153, 0.86);
        border-color: rgba(236, 72, 153, 0.92);
        box-shadow: 0 0 22px rgba(236, 72, 153, 0.38);
      }

      .cursor-follower.is-lensing {
        transform: translate(-50%, -50%) scale(4.8);
        opacity: 0;
        background-color: rgba(125, 249, 255, 0.72);
        border-color: rgba(241, 245, 249, 0.92);
        box-shadow:
          0 0 26px rgba(125, 249, 255, 0.48),
          inset 0 0 8px rgba(255, 255, 255, 0.36);
      }

      @media (hover: hover) and (pointer: fine) {
        :global(*),
        :global(*::before),
        :global(*::after) {
          cursor: none !important;
        }
      }

      @media (hover: none), (pointer: coarse) {
        .cursor-follower {
          display: none;
        }
      }
    </style>

    <script>
      let cleanupCustomCursor: (() => void) | null = null;

      function initCustomCursor() {
        cleanupCustomCursor?.();

        const cursor = document.querySelector('.cursor-follower') as HTMLElement | null;
        const canUseCustomCursor = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        if (!cursor || !canUseCustomCursor) {
          return;
        }

        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;
        let animationFrame = 0;

        const renderCursor = () => {
          currentX += (targetX - currentX) * 0.35;
          currentY += (targetY - currentY) * 0.35;
          cursor.style.left = `${currentX}px`;
          cursor.style.top = `${currentY}px`;
          animationFrame = requestAnimationFrame(renderCursor);
        };

        const handleMouseMove = (event: MouseEvent) => {
          cursor.classList.add('is-visible');
          targetX = event.clientX;
          targetY = event.clientY;

          if (!animationFrame) {
            currentX = targetX;
            currentY = targetY;
            animationFrame = requestAnimationFrame(renderCursor);
          }
        };

        const syncCursorState = (target: EventTarget | null) => {
          const element = target instanceof Element ? target : null;
          const isLensing = !!element?.closest('[data-image-magnifier]');
          const isHovering = !!element?.closest('a, button, .card');

          cursor.classList.toggle('is-lensing', isLensing);
          cursor.classList.toggle('is-hovering', !isLensing && isHovering);
        };

        const handleMouseOver = (event: MouseEvent) => {
          syncCursorState(event.target);
        };

        const handleMouseOut = (event: MouseEvent) => {
          syncCursorState(event.relatedTarget);
        };

        document.addEventListener('mousemove', handleMouseMove);
        document.addEventListener('mouseover', handleMouseOver);
        document.addEventListener('mouseout', handleMouseOut);

        cleanupCustomCursor = () => {
          document.removeEventListener('mousemove', handleMouseMove);
          document.removeEventListener('mouseover', handleMouseOver);
          document.removeEventListener('mouseout', handleMouseOut);
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          cursor.classList.remove('is-visible', 'is-hovering', 'is-lensing');
        };
      }

      document.addEventListener('astro:page-load', initCustomCursor);
      document.addEventListener('astro:before-preparation', () => {
        cleanupCustomCursor?.();
      });
    </script>
  </body>
</html>
